#!/bin/bash
# deskrun -- run a shell command on the Mac via the print-bridge cmd inbox and
# print its output. Usage: deskrun "shell command..."   (or pipe the script on stdin)
#
# Adapted from boweiliu/latchkey-dev-workbench (.agents/skills/latchkey-dev-workbench/bin/deskrun
# at 77edd07c8) for the per-device file server: every request names the device
# in both the URL and the X-Latchkey-Device header.
set -euo pipefail
CONF="$HOME/.config/latchkey-dev-workbench"
# The Mac to run on: MINDS_MAC_DEVICE, else a config file, else the most
# recently seen device.
DEVICE="${MINDS_MAC_DEVICE:-$(cat "$CONF/mac_device" 2>/dev/null || true)}"
if [ -z "$DEVICE" ]; then
  DEVICE="$(latchkey curl -s http://latchkey-self.invalid/devices | python3 -c 'import json,sys; print(json.load(sys.stdin)["devices"][0]["device_id"])')"
fi
FB="http://latchkey-self.invalid/minds-api-proxy/api/v1/files/$DEVICE"
# The bridge lives under the *Mac's* home, which differs from this container's
# $HOME. Resolve it from MINDS_MAC_HOME, else a config file, else fall back to
# $HOME (correct only when the container and Mac share a home path).
MAC_HOME="${MINDS_MAC_HOME:-$(cat "$CONF/mac_home" 2>/dev/null || echo "$HOME")}"
DIR="$MAC_HOME/tmp/minds_data/printbridge"
TIMEOUT="${DESKRUN_TIMEOUT:-60}"
lk() { latchkey curl -H "X-Latchkey-Device: $DEVICE" "$@"; }
name="dr-$(date +%s)-$$"
tmp="$(mktemp)"
if [ "$#" -gt 0 ]; then printf '%s\n' "$*" > "$tmp"; else cat > "$tmp"; fi
put_code="$(lk -s -o /dev/null -w "%{http_code}" -T "$tmp" "$FB$DIR/cmd/$name.cmd" || true)"
case "$put_code" in
  2*) ;;
  *) echo "deskrun: could not drop the command on the Mac (HTTP $put_code)" >&2; rm -f "$tmp"; exit 1 ;;
esac
# The helper moves the original snippet to cmd_done/<name>.cmd only AFTER it has
# finished writing <name>.cmd.out, so use the archived original as the "done"
# signal (the .out file itself exists mid-run and would read back partial).
for _ in $(seq 1 "$TIMEOUT"); do
  done_code="$(lk -s -o /dev/null -w "%{http_code}" "$FB$DIR/cmd_done/$name.cmd" 2>/dev/null || true)"
  if [ "$done_code" = "200" ]; then
    lk -s -o "$tmp.out" "$FB$DIR/cmd_done/$name.cmd.out" 2>/dev/null || true
    cat "$tmp.out"; rm -f "$tmp" "$tmp.out"; exit 0
  fi
  sleep 1
done
echo "deskrun: timed out waiting for $name output (is the bridge helper running on the Mac?)" >&2
rm -f "$tmp" "$tmp.out" 2>/dev/null || true
exit 1
